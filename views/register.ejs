<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/uploads/registerCss.css">
</head>
<body>
    <div class="auth-container">
        <h1>Create New Account</h1>
        
        <form action="/auth/register" method="POST">
            <div class="form-group">
                <label for="username">User Name:</label>
                <input type="text" id="username" name="username" required placeholder="Enter a username">
            </div>
            
            <div class="form-group" style="position: relative;">
                <label for="password">Password:</label>
                <input type="password" id="password" name="password" required placeholder="Enter your password" autocomplete="off" style="width: 100%; padding-right: 40px; box-sizing: border-box;">
        
                <span id="togglePassword" style="position: absolute; right: 12px; top: 50px; cursor: pointer; display: flex; align-items: center; color: #666;">
                    <svg id="eyeIcon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                        <circle cx="12" cy="12" r="3"></circle>
                    </svg>
                </span>
            </div>
            
            <button type="submit">Sign Up</button>

            <% if (locals.errorMessage) { %>
                <div class="errorMasseg">
                    <%= errorMessage %>
                </div>
            <% } %>
            
            <% if (locals.errorPassword) { %>
                <div class="errorMasseg">
                    <%= errorPassword %>
                </div>
            <% } %>

            <p class="haveAcc">Already have an account? <a href="/auth/login" class="loginPage">Login</a></p>
        </form>
    </div>

    <script>
        let passwordInput = document.querySelector("#password")
        let eyeIcon = document.querySelector("#eyeIcon")


        eyeIcon.addEventListener("click",()=>{
            if ( passwordInput.getAttribute("type")=== "password" ){
                passwordInput.type = "text"
                eyeIcon.innerHTML = `
            <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
            <line x1="1" y1="1" x2="23" y2="23"></line>
        `;
            }else{
                passwordInput.type = "password"
                eyeIcon.innerHTML = `
            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
            <circle cx="12" cy="12" r="3"></circle>
        `;
            }
        })




    </script>
</body>
</html>
