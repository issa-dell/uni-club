<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/uploads/registerCss.css">
</head>
<body>
    <div class="auth-container">
        <h1>Create New Account</h1>
        
        <form action="/auth/register" method="POST">
            <div class="form-group">
                <label for="username">User Name:</label>
                <input type="text" id="username" name="username" required placeholder="Enter a username">
            </div>
            
            <div class="form-group">
                <label for="password">Password:</label>
                <input type="password" id="password" name="password" required placeholder="Enter a password">
            </div>
            
            <button type="submit">Sign Up</button>

            <% if (locals.errorMessage) { %>
                <div class="errorMasseg">
                    <%= errorMessage %>
                </div>
            <% } %>
            
            <% if (locals.errorPassword) { %>
                <div class="errorMasseg">
                    <%= errorPassword %>
                </div>
            <% } %>

            <p class="haveAcc">Already have an account? <a href="/auth/login" class="loginPage">Login</a></p>
        </form>
    </div>
</body>
</html>
